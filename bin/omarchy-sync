#!/usr/bin/env bash
# Back up this Omarchy machine (config + installed software) into a git repo, and restore it.
# The tool lives in its own repo; the backup repo only holds configuration and instructions.
# The backup repo path is REPO= in ~/.config/omarchy-sync/config (default ~/omarchy-sync).
#
#   omarchy-sync init [path] [--github NAME | --remote URL | --local]   choose where backups go
#   omarchy-sync run                      update this tool, then sync now: bring in other machines' changes, back up, push
#   omarchy-sync apply | skip [item...]  answer "new configuration from another machine": all of it, or only the named files / theme, packages, plugins, claude-prefs, software
#   omarchy-sync pull [--dry-run] [--from REV [--base REV]]  only bring in other machines' changes (3-way; the other copy wins a conflict)
#   omarchy-sync status [--json]          state, schedule and the last 5 backups
#   omarchy-sync log [N] [machine]        last N backups (of every machine, or only one)
#   omarchy-sync machines                 machines in this backup repo and their latest backup
#   omarchy-sync interval <15min|30min|1h|6h|12h|24h|off>   change the schedule
#   omarchy-sync restore <rev|machine> [--dry-run]          restore files from a backup (a machine name = its latest)
#   omarchy-sync restore-packages [rev]   install packages recorded in a backup (sudo)
#   omarchy-sync setup [repo]             new machine: packages, files, services, then install
#   omarchy-sync restore-github [owner/name] [path]  new machine: sign in to GitHub, clone the backup, setup
#   omarchy-sync install | uninstall      timer + bar plugin
set -uo pipefail

TOOL="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-sync"
STATE="$STATE_DIR/last.json"
LOCK="$STATE_DIR/lock"
CONFIG_DIR="$HOME/.config/omarchy-sync"
CONFIG="$CONFIG_DIR/config"
UNIT_DIR="$HOME/.config/systemd/user"
INTERVALS="15min 30min 1h 6h 12h 24h off"
mkdir -p "$STATE_DIR"

config_value() { [ -f "$CONFIG" ] && sed -n "s/^$1=//p" "$CONFIG" | tail -1; }
set_config() { # key value
  mkdir -p "$CONFIG_DIR"; touch "$CONFIG"
  if grep -q "^$1=" "$CONFIG"; then sed -i "s|^$1=.*|$1=$2|" "$CONFIG"; else printf '%s=%s\n' "$1" "$2" >> "$CONFIG"; fi
}
# "~/x" and bare names like "backup" are relative to $HOME, never to the current directory.
abs_path() {
  local p="${1/#\~/$HOME}"
  case "$p" in /*) ;; *) p="$HOME/$p" ;; esac
  realpath -m "$p"
}
REPO=${OMARCHY_SYNC_REPO:-$(config_value REPO)}; REPO=$(abs_path "${REPO:-$HOME/omarchy-sync}")   # env override: tests

EXCLUDES=(
  --exclude='.git' --exclude='backups' --exclude='node_modules' --exclude='__pycache__'
  --exclude='auth.json' --exclude='hosts.yml' --exclude='*.keyring' --exclude='.claude.json'
  --exclude='*.sqlite*' --exclude='*.log' --exclude='*.sock' --exclude='*.lock'
  --exclude='/.claude/skills/synced' --exclude='omarchy-sync.service' --exclude='omarchy-sync.timer'
  --exclude='omarchy-sync.timer.d'
  --exclude='/.codex/skills/.system' --exclude='/.config/terminal/completions'
  --exclude='herdr-agent-state.*' --exclude='herdr-omp-agent-state.*'
  --exclude='history.jsonl' --exclude='*cache*' --exclude='*.bak*' --exclude='*.pre-dotfiles'
)
# Files that belong to ONE machine and never travel between machines: its screen, where its
# backup repo lives, and its per-screen text size (display-profile rewrites it on every screen change).
MACHINE_LOCAL=(.config/hypr/monitors.lua .config/omarchy-sync/config .config/omarchy/shell.toml)
for f in "${MACHINE_LOCAL[@]}"; do EXCLUDES+=(--exclude="/$f"); done
# Credentials never travel: sign-in files, keys, certificates, env files, OAuth/token stores.
EXCLUDES+=(
  --exclude='.credentials.json' --exclude='credentials*' --exclude='*.pem' --exclude='*.key' --exclude='*.p12'
  --exclude='id_rsa*' --exclude='id_ed25519*' --exclude='id_ecdsa*' --exclude='.env' --exclude='.env.*'
  --exclude='*.token' --exclude='tokens.json' --exclude='oauth*.json' --exclude='*secret*.json'
  --exclude='.netrc' --exclude='*.kdbx' --exclude='.npmrc' --exclude='.pypirc'
)
MAXSIZE=2M

MACHINE=$(hostname)

repo_ready() { git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 && [ -f "$REPO/sync.list" ]; }

# Machine a backup came from: its "Machine:" trailer, or for older backups the host in INVENTORY.md.
machine_of() { # rev
  local m
  m=$(git -C "$REPO" log -1 --format='%(trailers:key=Machine,valueonly,separator=)' "$1" 2>/dev/null)
  [ -n "$m" ] || m=$(git -C "$REPO" show "$1:INVENTORY.md" 2>/dev/null | sed -n 's/^- Host: \([^ ]*\).*/\1/p' | head -1)
  echo "${m:-?}"
}

# Latest backup made on a machine (snapshots and restores count: they are that machine's state).
latest_of_machine() { # machine
  local h
  for h in $(git -C "$REPO" log -300 --format=%h); do
    [ "$(machine_of "$h")" = "$1" ] && { echo "$h"; return 0; }
  done
  return 1
}
need_repo() { repo_ready || { echo "no backup location yet: run 'omarchy-sync init'" >&2; exit 4; }; }

get_interval() { local v; v=$(config_value INTERVAL); echo "${v:-1h}"; }

copy_files() { # $1 = "" or "-n" (dry run)
  local dry="$1" entry
  while IFS= read -r entry; do
    [[ -z "$entry" || "$entry" == \#* ]] && continue
    [ -e "$HOME/$entry" ] || continue
    if [ -d "$HOME/$entry" ]; then
      ( cd "$HOME" && rsync -aRc $dry --delete --max-size=$MAXSIZE "${EXCLUDES[@]}" --itemize-changes "./$entry/" "$REPO/home/" )
    else
      ( cd "$HOME" && rsync -aRc $dry --max-size=$MAXSIZE "${EXCLUDES[@]}" --itemize-changes "./$entry" "$REPO/home/" )
    fi
  done < "$REPO/sync.list"
  local list; list=$(mktemp); referenced_files > "$list"
  [ -s "$list" ] && ( cd "$HOME" && rsync -aRc $dry --files-from="$list" --max-size=$MAXSIZE "${EXCLUDES[@]}" --itemize-changes . "$REPO/home/" )
  rm -f "$list"
}

# Files that synced configs point at (~/.claude/statusline.sh in settings.json, a hook script...)
# travel too, even when sync.list does not name them: a setting is useless without its script.
# Only hidden config paths under $HOME; state, caches and plugin caches stay out.
referenced_files() {
  local user rel entry covered
  user=$(id -un)
  grep -rhoIE "(~|\\\$HOME|\\\$\\{HOME\\}|/home/$user)/\.[A-Za-z0-9._/-]+" "$REPO/home" 2>/dev/null \
    | sed -E "s#^(~|\\\$HOME|\\\$\\{HOME\\}|/home/$user)/##; s#[.]+\$##" | sort -u \
    | while IFS= read -r rel; do
        # Text files only: a referenced program (a symlink in ~/.local/bin, an AppImage, a mise
        # install) is documented in apps/, not copied.
        [ -f "$HOME/$rel" ] && [ ! -L "$HOME/$rel" ] && grep -qI '' "$HOME/$rel" || continue
        # Agent conversations (pi's self-compact state lists its session files) are work, not config.
        case "$rel" in .cache/*|.local/state/*|.local/share/omarchy/*|.local/share/mise/*|.local/share/pnpm/*|*/node_modules/*|*/cache/*|.claude/projects/*|.claude/plugins/*|.git/*|*/sessions/*|*.jsonl|*history*) continue ;; esac
        covered=""
        while IFS= read -r entry; do
          [[ -z "$entry" || "$entry" == \#* ]] && continue
          [[ "$rel" == "$entry" || "$rel" == "$entry"/* ]] && { covered=1; break; }
        done < "$REPO/sync.list"
        [ -n "$covered" ] || printf '%s\n' "$rel"
      done
}

# Write a command's output to a file, but keep the previous file when the command is
# missing or fails (e.g. npm is not on PATH under systemd): a tool that could not be
# queried must not look like "everything was uninstalled".
capture() { # file cmd...
  local out="$1" tmp; shift
  tmp=$(mktemp)
  if "$@" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    cmp -s "$tmp" "$out" || mv "$tmp" "$out"
  fi
  rm -f "$tmp"
}

# Which Claude Code marketplaces and plugins are installed, by name, so another machine can
# install the same ones (the plugin files themselves live in a per-machine cache).
claude_plugins_json() {
  local c="$HOME/.claude/plugins" json name path url
  [ -f "$c/installed_plugins.json" ] && [ -f "$c/known_marketplaces.json" ] || return 1
  json=$(jq -S -n --slurpfile i "$c/installed_plugins.json" --slurpfile m "$c/known_marketplaces.json" \
    '{marketplaces: ($m[0] | with_entries(.value = .value.source)), plugins: ($i[0].plugins | keys)}') || return 1
  # A marketplace that is a local folder with a GitHub remote is recorded by that repo, so other machines can clone it.
  while IFS=$'\t' read -r name path; do
    url=$(git -C "$path" remote get-url origin 2>/dev/null | sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##')
    [[ $url == */* && $url != *:* ]] || continue
    json=$(jq --arg n "$name" --arg r "$url" '.marketplaces[$n] = {source: "github", repo: $r}' <<<"$json")
  done < <(jq -r '.marketplaces | to_entries[] | select(.value.source == "directory") | [.key, .value.path] | @tsv' <<<"$json")
  printf '%s\n' "$json"
}

# ~/.claude.json mixes the sign-in with preferences. Only the preferences travel: trusted folders
# (with their allowed tools and MCP servers), user MCP servers, onboarding and "already seen"
# notices, so another machine stops asking the same questions. Account, IDs, caches and counters
# stay here; env/header values and anything named like a token are recorded as REDACTED.
claude_state_json() {
  [ -f "$HOME/.claude.json" ] || return 1
  jq -S --arg home "$HOME" '
    with_entries(select(.key | test("^(hasCompletedOnboarding|lastOnboardingVersion|hasSeen.*|hasReset.*|hasAcknowledged.*|bypassPermissionsModeAccepted|autoModeEnvSetup|theme|editorMode|autoUpdates|verbose|preferredNotifChannel|autoCompactEnabled|diffTool|autoConnectIde|claudeInChromeDefaultEnabled|mcpServers|projects|officialMarketplaceAutoInstall.*|groveChoiceSeenAt|.*MigrationComplete)$")))
    | if .projects then .projects |= with_entries(select(.key | startswith($home))
        | .value |= with_entries(select(.key | test("^(hasTrustDialogAccepted|allowedTools|mcpServers|enabledMcpjsonServers|disabledMcpjsonServers|hasCompletedProjectOnboarding|hasClaudeMdExternalIncludes.*)$")))) else . end
    | walk(if type == "object" then with_entries(
        if (.key | test("^(env|headers)$")) and (.value | type) == "object" then .value |= map_values(if type == "string" then "REDACTED" else . end)
        elif (.key | test("(?i)token|secret|password|api[_-]?key|authorization")) and (.value | type) == "string" then .value = "REDACTED"
        else . end)
      elif type == "string" then sub("Bearer [A-Za-z0-9._~+/=-]{20,}"; "Bearer REDACTED") else . end)' "$HOME/.claude.json"
}

# ~/.claude.json with a backup's preferences merged in (stdout). A REDACTED value never replaces a real one.
claude_state_merged() { # rev
  local want
  want=$(git -C "$REPO" show "$1:pkgs/claude-state.json" 2>/dev/null) || return 1
  jq --argjson want "$want" '
    def merge($a; $b): if ($a | type) == "object" and ($b | type) == "object"
      then reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]))
      elif $b == "REDACTED" and $a != null then $a else $b end;
    merge(.; $want)' "$HOME/.claude.json" 2>/dev/null
}

apply_claude_state() { # rev
  local tmp; tmp=$(mktemp)
  [ -f "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"
  if claude_state_merged "$1" > "$tmp" && [ -s "$tmp" ] && ! jq -e --slurpfile a "$tmp" '. == $a[0]' "$HOME/.claude.json" >/dev/null; then
    cp -p "$HOME/.claude.json" "$STATE_DIR/claude.json.before-apply"
    cat "$tmp" > "$HOME/.claude.json"   # in place: keeps the file's permissions
    echo "claude: preferences (trusted folders, MCP servers, notices)"
  fi
  rm -f "$tmp"
}

snapshot_software() {
  local p="$REPO/pkgs"; mkdir -p "$p"
  capture "$p/native.txt" sh -c 'pacman -Qqen | sort'
  capture "$p/foreign.txt" sh -c 'pacman -Qqem | sort'
  capture "$p/mise.txt" mise ls --current
  capture "$p/npm-global.txt" sh -c 'npm ls -g --depth=0 | tail -n +2'
  capture "$p/pnpm-global.txt" pnpm ls -g --depth=0
  capture "$p/uv-tools.txt" uv tool list
  capture "$p/services-user.txt" sh -c "systemctl --user list-unit-files --state=enabled --no-legend | awk '{print \$1}' | sort"
  capture "$p/services-system.txt" sh -c "systemctl list-unit-files --state=enabled --no-legend | awk '{print \$1}' | sort"
  capture "$p/etc-modified.txt" sh -c "pacman -Qii | awk '/^MODIFIED/ {print \$2}' | sort"
  capture "$p/herdr-integrations.txt" herdr integration status
  capture "$p/gsettings-interface.txt" gsettings list-recursively org.gnome.desktop.interface
  capture "$p/dconf.ini" dconf dump /
  capture "$p/claude-plugins.json" claude_plugins_json
  capture "$p/claude-state.json" claude_state_json
  # System keyboard layout (localectl): fcitx5 derives its default layout from it, so both machines need the same
  capture "$p/keyboard.txt" keyboard_now
  # Active theme and background (theme name, then the background's file name)
  capture "$p/omarchy-theme.txt" sh -c 'cat "$HOME/.local/state/omarchy/current/theme.name"; basename "$(readlink "$HOME/.local/state/omarchy/current/background")"'
  # Look toggles live in ~/.local/state, not ~/.config, so record the choices instead of the files
  capture "$p/omarchy-look.txt" sh -c 'omarchy-hyprland-toggle-enabled no-animations && echo animations=off || echo animations=on; echo "transparency=$(omarchy-hyprland-window-transparency)"'
}

# Apply a backup's look toggles (animations, window transparency), only where they differ
apply_look() { # rev
  local look want
  command -v omarchy >/dev/null || return 0
  look=$(git -C "$REPO" show "$1:pkgs/omarchy-look.txt" 2>/dev/null) || return 0
  want=$(sed -n 's/^animations=//p' <<<"$look")
  if [ "$want" = on ] && omarchy-hyprland-toggle-enabled no-animations; then omarchy toggle animations on >/dev/null 2>&1 || true
  elif [ "$want" = off ] && ! omarchy-hyprland-toggle-enabled no-animations; then omarchy toggle animations off >/dev/null 2>&1 || true
  fi
  want=$(sed -n 's/^transparency=//p' <<<"$look")
  [ -n "$want" ] && [ "$want" != "$(omarchy-hyprland-window-transparency)" ] && { omarchy hyprland window transparency "$want" >/dev/null 2>&1 || true; }
  return 0
}

# Everything that is not a plain file: the theme, look toggles, GTK appearance and the AI agents'
# plugins. Display scale and text size are NOT here: display-profile owns them on each machine.
# True when the other side changed this repo file since the shared state.
changed_upstream() { # rev base path
  [ "$(git -C "$REPO" show "$1:$3" 2>/dev/null)" != "$(git -C "$REPO" show "$2:$3" 2>/dev/null)" ]
}

# ONLY_EXTRAS (newline list of ids) limits apply_extras to the changes the user picked.
want_extra() { [ -z "${ONLY_EXTRAS+x}" ] || grep -qxF -- "$1" <<<"$ONLY_EXTRAS"; }

# The GTK appearance keys that travel, as "schema key value" lines of a backup
gsettings_wanted() { # rev
  git -C "$REPO" show "$1:pkgs/gsettings-interface.txt" 2>/dev/null \
    | awk '$2 ~ /^(icon-theme|gtk-theme|color-scheme|cursor-theme|cursor-size|accent-color)$/'
}

apply_extras() { # rev base
  local rev="$1" base="$2" want cur schema key value now
  if want_extra theme; then
    changed_upstream "$rev" "$base" pkgs/omarchy-look.txt && apply_look "$rev"
    want=$(git -C "$REPO" show "$rev:pkgs/omarchy-theme.txt" 2>/dev/null | head -1)
    cur=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
    if changed_upstream "$rev" "$base" pkgs/omarchy-theme.txt && [ -n "$want" ] && [ "$want" != "$cur" ] && command -v omarchy >/dev/null; then
      echo "theme: $cur -> $want"; omarchy theme set "$want" >/dev/null 2>&1 || echo "  could not set theme $want" >&2
    fi
    command -v gsettings >/dev/null && while read -r schema key value; do
      [ "$(git -C "$REPO" show "$base:pkgs/gsettings-interface.txt" 2>/dev/null | grep -F "$schema $key ")" = "$schema $key $value" ] && continue
      now=$(gsettings get "$schema" "$key" 2>/dev/null)
      [ "$now" = "$value" ] || { echo "$key: $now -> $value"; gsettings set "$schema" "$key" "$value" 2>/dev/null; }
    done < <(gsettings_wanted "$rev")
  fi
  want_extra claude-prefs && apply_claude_state "$rev"
  want_extra plugins && apply_claude_plugins "$rev"
  want_extra packages && apply_packages "$rev"
  want_extra software && apply_software "$rev"
  want_extra keyboard && apply_keyboard "$rev"
}

# Global pnpm tools the backup has newer (or that are missing here): name<TAB>version
pnpm_behind() { # rev
  command -v pnpm >/dev/null || return 0
  local name ver have
  while IFS=$'\t' read -r name ver; do
    [ "$name" = pnpm ] && continue
    have=$(pnpm ls -g --depth=0 2>/dev/null | sed -n "s|^[├└]── $name@||p" | head -1)
    [ -z "$have" ] || [ "$(printf '%s\n%s\n' "$have" "$ver" | sort -V | tail -1)" != "$have" ] && printf '%s\t%s\n' "$name" "$ver"
  done < <(git -C "$REPO" show "$1:pkgs/pnpm-global.txt" 2>/dev/null | sed -n 's/^[├└]── \(.*\)@\([^@]*\)$/\1\t\2/p')
}

# Agents whose herdr integration is installed in the backup but missing or a different version here
herdr_behind() { # rev
  command -v herdr >/dev/null || return 0
  comm -23 <(git -C "$REPO" show "$1:pkgs/herdr-integrations.txt" 2>/dev/null | grep -E ': (current|outdated)' | sort) \
           <(herdr integration status 2>/dev/null | sort) | cut -d: -f1
}

# Packages the other machine has (union, nothing is removed). Needs root: sudo asks for the
# password right here in a terminal; from the bar or the timer, a floating terminal opens to ask it
# (Omarchy runs no polkit agent, so pkexec would just fail there).
apply_packages() { # rev
  local rev="$1" native aur cmd pkgs
  pkgs=$(missing_packages "$rev")
  [ -n "$pkgs" ] || return 0
  echo "packages: $(tr '\n' ' ' <<<"$pkgs")"
  native=$(comm -12 <(sort <<<"$pkgs") <(git -C "$REPO" show "$rev:pkgs/native.txt" 2>/dev/null | sort -u) | tr '\n' ' ')
  aur=$(comm -12 <(sort <<<"$pkgs") <(git -C "$REPO" show "$rev:pkgs/foreign.txt" 2>/dev/null | sort -u) | tr '\n' ' ')
  cmd="true"
  [ -z "${native// }" ] || cmd="$cmd && sudo pacman -S --needed --noconfirm $native"
  [ -z "${aur// }" ] || ! command -v yay >/dev/null || cmd="$cmd && yay -S --needed --noconfirm $aur"
  run_as_root "Installing the packages the other machine has: $native$aur" "$cmd"
}

# Run a command that needs sudo: here when this is a terminal, otherwise in a floating terminal
# that asks for the password (the timer and the bar have no terminal of their own).
run_as_root() { # title command
  if [ -t 0 ]; then
    bash -c "$2" || echo "  failed: $1" >&2
  elif command -v omarchy-launch-floating-terminal-with-presentation >/dev/null; then
    omarchy-launch-floating-terminal-with-presentation "echo '$1'; $2" >/dev/null 2>&1 </dev/null &
    disown 2>/dev/null
  else
    echo "  needs a terminal for the password: $2" >&2
  fi
}

# System keyboard layout as "key=value" lines: X11 layout/variant/model and console keymap
keyboard_now() {
  command -v localectl >/dev/null || return 1
  localectl status 2>/dev/null | sed -n 's/^ *VC Keymap: */vc=/p; s/^ *X11 Layout: */layout=/p; s/^ *X11 Variant: */variant=/p; s/^ *X11 Model: */model=/p'
}

keyboard_behind() { # rev -> "layout -> layout" when the backup's keyboard differs from this machine's
  local want now
  want=$(git -C "$REPO" show "$1:pkgs/keyboard.txt" 2>/dev/null) || return 0
  now=$(keyboard_now) || return 0
  [ "$want" = "$now" ] || echo "$(sed -n 's/^layout=//p' <<<"$now") -> $(sed -n 's/^layout=//p' <<<"$want")"
}

apply_keyboard() { # rev
  local want layout variant model vc cmd="true"
  [ -n "$(keyboard_behind "$1")" ] || return 0
  want=$(git -C "$REPO" show "$1:pkgs/keyboard.txt" 2>/dev/null)
  layout=$(sed -n 's/^layout=//p' <<<"$want"); variant=$(sed -n 's/^variant=//p' <<<"$want")
  model=$(sed -n 's/^model=//p' <<<"$want"); vc=$(sed -n 's/^vc=//p' <<<"$want")
  [ -z "$layout" ] || cmd="$cmd && sudo localectl set-x11-keymap '$layout' '$model' '$variant'"
  [ -z "$vc" ] || cmd="$cmd && sudo localectl set-keymap '$vc'"
  # fcitx5 reads the layout at start: restart it so the keyboard follows right away
  cmd="$cmd && { fcitx5-remote -e 2>/dev/null; sleep 1; setsid -f fcitx5 -d >/dev/null 2>&1; true; }"
  echo "keyboard: $(keyboard_behind "$1")"
  run_as_root "Setting the keyboard layout like the other machine: $layout" "$cmd"
}

# mise tools the backup has newer: name<TAB>version (pkgs/mise.txt: name version source requested)
mise_behind() { # rev
  command -v mise >/dev/null || return 0
  local name ver have
  while read -r name ver _; do
    [ -n "$name" ] || continue
    have=$(mise ls --current 2>/dev/null | awk -v n="$name" '$1 == n {print $2; exit}')
    [ -z "$have" ] || [ "$(printf '%s\n%s\n' "$have" "$ver" | sort -V | tail -1)" != "$have" ] && printf '%s\t%s\n' "$name" "$ver"
  done < <(git -C "$REPO" show "$1:pkgs/mise.txt" 2>/dev/null)
}

# Tools the other machine has: pnpm globals (Codex, Pi), mise tools, herdr integrations and Pi's packages.
apply_software() { # rev
  local rev="$1" name ver a
  command -v mise >/dev/null && { mise install -q >/dev/null 2>&1 || echo "  mise install failed" >&2; }
  # Same exact version on both machines: `mise use -g` pins it in mise's config.toml, which is synced.
  while IFS=$'\t' read -r name ver; do
    [ -n "$name" ] || continue
    echo "mise: $name@$ver"; mise use -g -q "$name@$ver" >/dev/null 2>&1 || echo "  could not install $name@$ver" >&2
  done < <(mise_behind "$rev")
  while IFS=$'\t' read -r name ver; do
    [ -n "$name" ] || continue
    echo "pnpm: $name@$ver"; pnpm add -g "$name@$ver" >/dev/null 2>&1 || echo "  could not install $name@$ver" >&2
  done < <(pnpm_behind "$rev")
  for a in $(herdr_behind "$rev"); do
    echo "herdr integration: $a"; herdr integration install "$a" >/dev/null 2>&1 || echo "  could not install the herdr integration for $a" >&2
  done
  if command -v pi >/dev/null && [ -f "$HOME/.pi/agent/settings.json" ]; then
    for a in $(jq -r '.packages[]? | strings' "$HOME/.pi/agent/settings.json"); do
      grep -qF "\"${a#npm:}\"" "$HOME/.pi/agent/npm/package.json" 2>/dev/null && [ -d "$HOME/.pi/agent/npm/node_modules/${a#npm:}" ] && continue
      echo "pi: $a"; pi install "$a" >/dev/null 2>&1 || echo "  could not install Pi package $a" >&2
    done
  fi
}

apply_claude_plugins() { # rev
  local rev="$1" json name source plugin have dir
  command -v claude >/dev/null || return 0
  json=$(git -C "$REPO" show "$rev:pkgs/claude-plugins.json" 2>/dev/null) || return 0
  have=$(claude plugin marketplace list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null)
  while IFS=$'\t' read -r name source; do
    grep -qx "$name" <<<"$have" && continue
    case "$(jq -r .source <<<"$source")" in
      github)    source=$(jq -r .repo <<<"$source")
                 # settings.json may name the marketplace by a local folder (extraKnownMarketplaces): clone it there,
                 # or Claude refuses the GitHub source as "doesn't match its extraKnownMarketplaces entry".
                 dir=$(jq -r --arg n "$name" '.extraKnownMarketplaces[$n].source | select(.source == "directory") | .path' "$HOME/.claude/settings.json" 2>/dev/null)
                 if [ -n "$dir" ]; then
                   [ -d "$dir" ] || { mkdir -p "$(dirname "$dir")"; git clone -q "https://github.com/$source" "$dir"; } \
                     || { echo "claude marketplace '$name': could not clone $source into $dir" >&2; continue; }
                   source=$dir
                 fi ;;
      git|url)   source=$(jq -r '.url // .repo' <<<"$source") ;;
      directory) source=$(jq -r .path <<<"$source")
                 [ -d "$source" ] || { echo "claude marketplace '$name': local folder $source is missing here (publish it to a git remote)" >&2; continue; } ;;
    esac
    echo "claude marketplace: $name"; claude plugin marketplace add "$source" >/dev/null 2>&1 || echo "  could not add $name" >&2
  done < <(jq -r '.marketplaces | to_entries[] | [.key, (.value|tojson)] | @tsv' <<<"$json")
  have=$(claude plugin list --json 2>/dev/null | jq -r '.[].id' 2>/dev/null)
  while read -r plugin; do
    grep -qx "$plugin" <<<"$have" && continue
    echo "claude plugin: $plugin"; claude plugin install "$plugin" >/dev/null 2>&1 || echo "  could not install $plugin" >&2
  done < <(jq -r '.plugins[]' <<<"$json")
}

# Non-file differences between a backup and this machine, one per line as "id<TAB>label", each one
# something the user can apply or decline on its own (ids: theme packages plugins claude-prefs software).
extras_diff() { # rev base
  local rev="$1" base="$2" want cur n look="" parts=""
  want=$(git -C "$REPO" show "$rev:pkgs/omarchy-theme.txt" 2>/dev/null | head -1)
  cur=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
  changed_upstream "$rev" "$base" pkgs/omarchy-theme.txt && [ -n "$want" ] && [ "$want" != "$cur" ] && look="theme $cur -> $want"
  if changed_upstream "$rev" "$base" pkgs/omarchy-look.txt && command -v omarchy >/dev/null \
     && [ "$(git -C "$REPO" show "$rev:pkgs/omarchy-look.txt" 2>/dev/null)" != "$(omarchy-hyprland-toggle-enabled no-animations && echo animations=off || echo animations=on; echo "transparency=$(omarchy-hyprland-window-transparency)")" ]; then
    look="${look:+$look, }animations/transparency"
  fi
  if command -v gsettings >/dev/null && changed_upstream "$rev" "$base" pkgs/gsettings-interface.txt \
     && [ "$(gsettings_wanted "$rev")" != "$(gsettings list-recursively org.gnome.desktop.interface 2>/dev/null | awk '$2 ~ /^(icon-theme|gtk-theme|color-scheme|cursor-theme|cursor-size|accent-color)$/')" ]; then
    look="${look:+$look, }GTK appearance"
  fi
  [ -z "$look" ] || printf 'theme\t%s\n' "$look"
  if changed_upstream "$rev" "$base" pkgs/native.txt || changed_upstream "$rev" "$base" pkgs/foreign.txt; then
    n=$(missing_packages "$rev" | wc -l); [ "$n" -eq 0 ] || printf 'packages\t%s packages to install\n' "$n"
  fi
  if command -v claude >/dev/null && changed_upstream "$rev" "$base" pkgs/claude-plugins.json && git -C "$REPO" cat-file -e "$rev:pkgs/claude-plugins.json" 2>/dev/null; then
    n=$(comm -23 <(git -C "$REPO" show "$rev:pkgs/claude-plugins.json" | jq -r '.plugins[]' | sort) \
                 <(claude plugin list --json 2>/dev/null | jq -r '.[].id' | sort) | wc -l)
    [ "$n" -eq 0 ] || printf 'plugins\t%s Claude plugins to install\n' "$n"
  fi
  if changed_upstream "$rev" "$base" pkgs/claude-state.json && [ -f "$HOME/.claude.json" ] \
     && ! claude_state_merged "$rev" | jq -e --slurpfile a "$HOME/.claude.json" '. == $a[0]' >/dev/null 2>&1; then
    printf 'claude-prefs\tClaude preferences (trusted folders, MCP servers)\n'
  fi
  if changed_upstream "$rev" "$base" pkgs/pnpm-global.txt; then
    n=$(pnpm_behind "$rev" | wc -l); [ "$n" -eq 0 ] || parts="$n pnpm tools"
  fi
  if changed_upstream "$rev" "$base" pkgs/herdr-integrations.txt; then
    n=$(herdr_behind "$rev" | wc -l); [ "$n" -eq 0 ] || parts="${parts:+$parts, }$n herdr integrations"
  fi
  if changed_upstream "$rev" "$base" pkgs/mise.txt; then
    n=$(mise_behind "$rev" | wc -l); [ "$n" -eq 0 ] || parts="${parts:+$parts, }$n mise tools"
  fi
  [ -z "$parts" ] || printf 'software\t%s to update\n' "$parts"
  if changed_upstream "$rev" "$base" pkgs/keyboard.txt; then
    n=$(keyboard_behind "$rev"); [ -z "$n" ] || printf 'keyboard\tkeyboard layout %s\n' "$n"
  fi
}

# ---------- Inventory: software that does not come from pacman ----------
id_from_path() { # absolute path -> app id
  local p="${1#"$HOME"/}"
  case "$p" in
    .local/share/*) p="${p#.local/share/}"; echo "${p%%/*}" ;;
    .local/bin/*)   p="${p#.local/bin/}";   echo "${p%%/*}" ;;
    .config/*)      p="${p#.config/}";      echo "${p%%/*}" ;;
    .*/*)           p="${p#.}";             echo "${p%%/*}" ;;
    *)              basename "$p" ;;
  esac
}

detect_apps() { # prints: id<TAB>path<TAB>source
  local f t exe
  for f in "$HOME"/.local/bin/*; do
    [ -e "$f" ] || continue
    t=$(readlink -f "$f"); printf '%s\t%s\t%s\n' "$(id_from_path "$t")" "$t" "~/.local/bin/$(basename "$f")"
  done
  for f in "$HOME"/.local/share/applications/*.desktop; do
    [ -e "$f" ] || continue
    exe=$(sed -n 's/^Exec=//p' "$f" | head -1 | sed -E 's/^"([^"]+)".*/\1/; s/^([^ ]+).*/\1/')
    case "$exe" in "$HOME"/*) printf '%s\t%s\t%s\n' "$(id_from_path "$exe")" "$exe" "desktop:$(basename "$f")" ;; esac
  done
}

documented_ids() { cat "$REPO"/apps/*.md 2>/dev/null | sed -n 's/^ids: *//p' | tr ' ' '\n' | sort -u; }

undocumented_ids() { comm -23 <(detect_apps | cut -f1 | sort -u) <(documented_ids); }

cmd_inventory() {
  local out="$REPO/INVENTORY.md" id path src ver doc
  {
    echo "# Machine inventory"
    echo
    echo "> Generated by \`omarchy-sync\` on every backup. Do not edit by hand."
    echo "> Agents: read \`AGENTS.md\` first."
    echo
    echo "## System"
    echo "- Host: $(hostname) — $(uname -srm)"
    echo "- Omarchy: $(omarchy version 2>/dev/null | head -1)"
    echo "- Shell: $SHELL — Terminal: foot — Compositor: Hyprland"
    echo "- pacman packages: $(pacman -Qqen | wc -l) native, $(pacman -Qqem | wc -l) foreign/AUR (see \`pkgs/\`)"
    echo "- Backup schedule: every $(get_interval)"
    echo
    echo "## Software installed outside pacman"
    echo "Each row needs its own install. Steps live in \`apps/<id>.md\`; \`—\` in Doc means it is not documented yet."
    echo
    echo "| id | path | source | version | doc |"
    echo "|----|------|--------|---------|-----|"
    detect_apps | sort -u | while IFS=$'\t' read -r id path src; do
      ver=""
      if [ -x "$path" ] && [ -f "$path" ] && [[ "$path" != *.AppImage ]] && [ "$(head -c4 "$path" 2>/dev/null | tr -d '\0')" = $'\x7f'ELF ]; then
        ver=$(timeout 3 "$path" --version 2>/dev/null | head -1 | cut -c1-60)
      fi
      doc="—"; documented_ids | grep -qx "$id" && doc="apps/…"
      echo "| $id | \`${path/#$HOME/~}\` | ${src} | ${ver:-?} | $doc |"
    done
    echo
    echo "## Tools by manager"
    echo '```'; cat "$REPO/pkgs/mise.txt" 2>/dev/null; echo; cat "$REPO/pkgs/uv-tools.txt" 2>/dev/null; echo; cat "$REPO/pkgs/npm-global.txt" 2>/dev/null; echo '```'
    echo
    echo "## AI agents and their herdr integration"
    echo '```'; cat "$REPO/pkgs/herdr-integrations.txt" 2>/dev/null; echo '```'
    echo
    echo "## App data that is NOT backed up (sign in again)"
    for d in "$HOME"/.config/*/; do
      n=$(basename "$d")
      grep -qE "^\.config/$n(/|$)" "$REPO/sync.list" || echo "- ~/.config/$n"
    done
    echo
    echo "## Enabled systemd user services"
    sed 's/^/- /' "$REPO/pkgs/services-user.txt" 2>/dev/null
  } > "$out"
}

# Secret values pasted into configs (Bearer tokens, `api_key = "..."`, sk-/ghp_ keys) are replaced by
# REDACTED in the copy that gets committed; the live file is never touched.
redact_secrets() {
  grep -rlIP 'Bearer [A-Za-z0-9_.~+/=-]{20,}|(?i)(api[_-]?key|secret|token|passwd|password)["\x27 ]*[:=]["\x27 ]*(?=[A-Za-z0-9_.\/+=-]*\d)[A-Za-z0-9_.\/+=-]{20,}|sk-[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{30,}' "$REPO/home" 2>/dev/null \
    | xargs -r perl -pi -e 's/(Bearer )[A-Za-z0-9_.~+\/=-]{20,}/$1REDACTED/g;
        s/((?:api[_-]?key|secret|token|passwd|password)["\x27 ]*[:=]["\x27 ]*)(?=[A-Za-z0-9_.\/+=-]*\d)[A-Za-z0-9_.\/+=-]{20,}/$1REDACTED/gi;
        s/sk-[A-Za-z0-9]{20,}/REDACTED/g; s/gh[pousr]_[A-Za-z0-9]{30,}/REDACTED/g'
}

secret_scan() {
  # Prints matches when something about to be committed looks like a secret.
  cd "$REPO" || return 0
  git add -A >/dev/null 2>&1
  git diff --cached -U0 | grep -E '^\+[^+]' \
    | grep -P "(?i)(api[_-]?key|secret|token|passwd|password|bearer)[\"' ]*[:=][\"' ]*(?=[A-Za-z0-9_./+=-]*\d)[A-Za-z0-9_./+=-]{20,}|Bearer\s+(?!REDACTED)[A-Za-z0-9_.~+/=-]{20,}|sk-[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY" \
    | head -5
}

write_state() { # status message push [extra-json]
  local x="${4:-}"; [ -n "$x" ] || x='{}'
  jq -n --arg s "$1" --arg m "$2" --arg p "$3" --arg t "$(date -Iseconds)" --argjson x "$x" \
    '{status:$s,message:$m,push:$p,time:$t} + $x' > "$STATE"
}

state_field() { [ -f "$STATE" ] && jq -r ".$1 // empty" "$STATE" 2>/dev/null; }

# What a staged backup touches, by app: "hypr, herdr, pi +2". Reads the index.
changed_areas() {
  git diff --cached --name-only | awk -F/ '
    $1=="home" { a=$2; if (a==".config") a=$3; else if (a==".local") a=$4; sub(/^\./, "", a) }
    $1=="pkgs" { a="packages" }
    $1=="apps" { a="install notes" }
    $1!="home" && $1!="pkgs" && $1!="apps" { next }
    !seen[a]++ { n++; if (n<=4) list=list (n>1?", ":"") a }
    END { if (n==0) print "inventory"; else print list (n>4 ? " +" (n-4) : "") }'
}

# Commit whatever changed. $1 = commit subject (optional). Assumes the lock is held.
backup() {
  local subject="${1:-}" hits n extra
  cd "$REPO" || return 1
  copy_files "" >/dev/null
  for f in "${MACHINE_LOCAL[@]}"; do git rm -q --cached --ignore-unmatch "home/$f" >/dev/null; rm -f "$REPO/home/$f"; done
  redact_secrets
  snapshot_software
  cmd_inventory
  hits=$(secret_scan)
  if [ -n "$hits" ]; then
    git reset -q
    write_state error "Possible secret found; backup aborted" none
    notify-send -u critical "Backup aborted" "Something looks like a secret. Run: omarchy-sync status" 2>/dev/null
    echo "$hits" >&2; return 2
  fi
  extra=$(jq -n --arg r "$(state_field restoreRev)" 'if $r == "" then {} else {restoreRev:$r} end')
  if git diff --cached --quiet; then
    # Nothing new, but an earlier push may have failed: retry it rather than report "No changes"
    # while those backups sit on this machine only.
    if [ "$(push_state)" = local ] && git remote | grep -q . && [ -z "${OMARCHY_SYNC_NOPUSH:-}" ]; then
      push_and_record "No changes; earlier backups pushed" "$extra"; echo "no changes"; return
    fi
    write_state ok "No changes" "$(push_state)" "$extra"; echo "no changes"; return 0
  fi
  n=$(git diff --cached --name-only | wc -l)
  [ -n "$subject" ] || subject="backup: $(date '+%Y-%m-%d %H:%M') · $MACHINE · $(changed_areas)"
  git commit -q -m "$subject" -m "$(git diff --cached --name-status | head -200)" --trailer "Machine: $MACHINE" || { write_state error "Commit failed" none "$extra"; return 1; }
  if ! git remote | grep -q .; then
    write_state ok "$n files backed up (local only, no remote)" local "$extra"
  elif [ -n "${OMARCHY_SYNC_NOPUSH:-}" ]; then
    write_state ok "$n files backed up (not pushed)" local "$extra"
  else
    push_and_record "$n files backed up" "$extra"
  fi
  echo "backed up $n files"
}

# A failed push is an error, not "ok": the bar turns red and the other machines can't see
# these backups until it is fixed. $1 = message on success, $2 = extra state json.
push_and_record() {
  if push_backup; then
    write_state ok "$1" pushed "$2"
  else
    write_state error "Push failed: $(head -c 120 "$STATE_DIR/push.err" | tr '\n' ' ')" local "$2"
    notify-send -u critical "Backup not pushed" "Backups stay on this machine only. Run: omarchy-sync status" 2>/dev/null
    return 1
  fi
}

# Several machines push to one branch. When another one pushed first, merge its history in:
# this machine's files (home/, pkgs/, INVENTORY.md) win, shared files (sync.list, apps/,
# AGENTS.md) keep both sides' edits, and every machine's backups stay restorable.
push_backup() {
  local err="$STATE_DIR/push.err" pre up
  git push -q 2>"$err" && return 0
  up=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null) || return 1
  timeout 60 git fetch -q 2>>"$err" || return 1
  git merge-base --is-ancestor "$up" HEAD && return 1   # not behind: the push failed for another reason
  pre=$(git rev-parse HEAD)
  git merge -q --no-commit --no-ff --allow-unrelated-histories -X ours "$up" >/dev/null 2>&1 || true
  git rm -rq --cached --ignore-unmatch home pkgs INVENTORY.md
  git checkout "$pre" -- home pkgs INVENTORY.md
  git clean -fdq home pkgs
  git add -A
  git commit -q -m "merge: backups from other machines" --trailer "Machine: $MACHINE" 2>>"$err" || { git merge --abort 2>/dev/null; return 1; }
  git push -q 2>>"$err"
}

take_lock() { exec 9>"$LOCK"; flock -n 9 || { echo "a backup is already running" >&2; exit 3; }; }

PLUGIN_DIR="$HOME/.config/omarchy/plugins/jj.backup-status"

# Keep every machine on the latest tool and bar plugin: pull this tool's repo and, when it
# moved, reinstall (plugin, units) and re-run with the new script. Local edits are left alone.
self_update() { # args to re-run with
  [ -z "${OMARCHY_SYNC_UPDATED:-}" ] || return 0
  git -C "$TOOL" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local before err="$STATE_DIR/self-update.err"
  before=$(git -C "$TOOL" rev-parse HEAD)
  # --autostash keeps local edits to the tool: they are set aside, the update is applied, and they come back.
  if timeout 60 git -C "$TOOL" pull -q --ff-only --autostash 2>"$err"; then
    rm -f "$err" "$STATE_DIR/self-update.notified"
    if [ "$(git -C "$TOOL" rev-parse HEAD)" != "$before" ]; then
      echo "omarchy-sync updated: $(git -C "$TOOL" rev-parse --short "$before") -> $(git -C "$TOOL" rev-parse --short HEAD)"
      cmd_install >/dev/null
      OMARCHY_SYNC_UPDATED=1 exec "$TOOL/bin/omarchy-sync" "$@"
    fi
  else
    # Keep working with the current version, but say so once: a machine on an old tool syncs wrong.
    echo "omarchy-sync could not update itself: $(head -c 200 "$err" | tr '\n' ' ')" >&2
    if [ ! -f "$STATE_DIR/self-update.notified" ]; then
      touch "$STATE_DIR/self-update.notified"
      notify-send -u critical -a "Sync" "omarchy-sync could not update itself" "$(head -c 200 "$err")" 2>/dev/null
    fi
  fi
  # Pulled by hand but never installed: the bar would keep running the old plugin, the timer the old schedule.
  diff -rq "$TOOL/plugin/jj.backup-status" "$PLUGIN_DIR" >/dev/null 2>&1 \
    || rsync -a --delete "$TOOL/plugin/jj.backup-status/" "$PLUGIN_DIR/"
  cmp -s "$TOOL/systemd/omarchy-sync.timer" "$UNIT_DIR/omarchy-sync.timer" || cmd_install >/dev/null
}

# The other machine's copy (stdout) with each line holding REDACTED replaced by this machine's line
# that starts the same way (same key), so a synced config keeps this machine's real secrets.
fill_redacted() { # other-copy live
  perl -e 'open my $l, "<", $ARGV[1] or exit 1; my @live = <$l>;
    open my $o, "<", $ARGV[0] or exit 1;
    while (<$o>) { if (/^(.*?)REDACTED/) { my $p = $1; my ($m) = grep { index($_, $p) == 0 && !/REDACTED/ } @live; $_ = $m if defined $m } print }' "$1" "$2"
}

# Bring in what OTHER machines changed, file by file (3-way against the last state both sides
# share). A file is replaced only when this machine has not touched it since then; otherwise
# the local file stays and the other version is kept in $STATE_DIR/conflicts. Every file that
# gets replaced is first copied to $STATE_DIR/overwritten, so nothing is ever lost.
# $1 = "" or "-n" (list only). Assumes the lock is held.
# $1 = "" apply | "-n" list only | "-s" stage: write incoming.json and return 10 when there is something to ask about.
pull_changes() {
  local dry="${1:-}" stage="" up base from rel live stamp tmp mode note id label applied=0 kept=0 hypr=0 ff=0 files kept_files both_files extras
  [ "$dry" != "-s" ] || { stage=1; dry="-n"; }
  if [ -n "${PULL_FROM:-}" ]; then   # explicit revision (pull --from): no fetch, no fast-forward
    up=$(git -C "$REPO" rev-parse -q --verify "$PULL_FROM^{commit}") || { echo "unknown revision: $PULL_FROM" >&2; return 1; }
  else
    git -C "$REPO" remote | grep -q . || return 0
    [ -z "${OMARCHY_SYNC_NOPUSH:-}" ] || return 0
    timeout 60 git -C "$REPO" fetch -q 2>/dev/null || return 0
    up=$(git -C "$REPO" rev-parse -q --verify '@{u}') || return 0
  fi
  [ -n "${PULL_FROM:-}" ] || ! git -C "$REPO" merge-base --is-ancestor "$up" HEAD || return 0
  # Histories that never met (two repos joined for the first time): everything counts as "changed on
  # both sides" unless identical, so the local file is kept.
  if [ -n "${PULL_BASE:-}" ]; then base=$(git -C "$REPO" rev-parse -q --verify "$PULL_BASE^{commit}") || { echo "unknown revision: $PULL_BASE" >&2; return 1; }
  else base=$(git -C "$REPO" merge-base HEAD "$up") || base=$(git -C "$REPO" hash-object -t tree /dev/null); fi
  from=$(machine_of "$up"); stamp=$(date +%Y%m%d-%H%M%S); tmp=$(mktemp)
  LAST_UP=$up; LAST_BASE=$base; LAST_FROM=$from; files=""; kept_files=""; both_files=""
  [ -n "${PULL_FROM:-}" ] || ! git -C "$REPO" merge-base --is-ancestor HEAD "$up" || ff=1

  while IFS= read -r rel; do
    rel=${rel#home/}
    case " ${MACHINE_LOCAL[*]} " in *" $rel "*) continue ;; esac
    [ -z "${ONLY_FILES+x}" ] || grep -qxF -- "$rel" <<<"$ONLY_FILES" || continue
    # Declined before ("Not now" on this very copy): stays out until the other machine changes it again.
    [ -z "$stage" ] || [ "$(declined_blob "$rel")" != "$(git -C "$REPO" rev-parse -q "$up:home/$rel" 2>/dev/null)" ] || continue
    live="$HOME/$rel"
    mode=$(git -C "$REPO" ls-tree "$up" "home/$rel" | cut -c1-6)
    [ "$mode" = 120000 ] && continue
    git -C "$REPO" show "$up:home/$rel" > "$tmp" 2>/dev/null || continue
    cmp -s "$tmp" "$live" && continue                       # already identical
    # Secrets stay per machine: the other copy's REDACTED values are filled from this machine's file.
    if [ -e "$live" ] && grep -q REDACTED "$tmp"; then
      fill_redacted "$tmp" "$live" > "$tmp.fill" && cat "$tmp.fill" > "$tmp"; rm -f "$tmp.fill"
      cmp -s "$tmp" "$live" && continue
    fi
    note=""
    if [ ! -e "$live" ] && ! git -C "$REPO" cat-file -e "$base:home/$rel" 2>/dev/null; then
      :                                                     # new file from the other machine
    elif [ -e "$live" ] && git -C "$REPO" show "$base:home/$rel" 2>/dev/null | cmp -s - "$live"; then
      :                                                     # untouched here since the shared state
    elif [ "$(config_value CONFLICTS)" = mine ]; then       # opt-out: keep this machine's edits
      kept=$((kept + 1)); kept_files+="$rel"$'\n'; [ -n "$stage" ] || echo "keep local   $rel  (changed on both machines)"
      [ -n "$dry" ] || { mkdir -p "$STATE_DIR/conflicts/$stamp/$(dirname "$rel")"; cp "$tmp" "$STATE_DIR/conflicts/$stamp/$rel.from-$from"; }
      continue
    else
      # Changed on both machines. They must stay identical, and the user approved this machine's
      # changes by applying them, so the other copy wins; this one is kept in conflicts/ (and overwritten/).
      note="  (changed here too; yours saved in conflicts/)"; both_files+="$rel"$'\n'
      [ -n "$dry" ] || { mkdir -p "$STATE_DIR/conflicts/$stamp/$(dirname "$rel")"; cp -p "$live" "$STATE_DIR/conflicts/$stamp/$rel.mine"; }
    fi
    applied=$((applied + 1)); files+="$rel"$'\n'; [ -n "$stage" ] || echo "from $from   $rel$note"
    grep -q REDACTED "$tmp" && { [ -n "$stage" ] || echo "             fill in the secret values marked REDACTED in ~/$rel"; }
    [ -n "$dry" ] && continue
    if [ -e "$live" ]; then mkdir -p "$STATE_DIR/overwritten/$stamp/$(dirname "$rel")"; cp -p "$live" "$STATE_DIR/overwritten/$stamp/$rel"; fi
    mkdir -p "$(dirname "$live")"; cat "$tmp" > "$live"
    [ "$mode" = 100755 ] && chmod +x "$live"
    case "$rel" in .config/hypr/*) hypr=1 ;; esac
  done < <(git -C "$REPO" diff --name-only --diff-filter=AM "$base" "$up" -- home)
  rm -f "$tmp"

  if [ -n "$stage" ]; then
    extras=""
    while IFS=$'\t' read -r id label; do
      [ -n "$id" ] && [ "$(declined_extra "$id")" != "$up" ] && extras+="$id"$'\t'"$label"$'\n'
    done < <(extras_diff "$up" "$base")
    if [ "$applied" -eq 0 ] && [ -z "$extras" ]; then rm -f "$STATE_DIR/incoming.json"; return 0; fi
    jq -n --arg from "$from" --arg rev "$up" --arg base "$base" --arg time "$(date -Iseconds)" \
      --argjson files "$(printf '%s' "$files" | jq -R . | jq -s 'map(select(length>0))')" \
      --argjson both "$(printf '%s' "$both_files" | jq -R . | jq -s 'map(select(length>0))')" \
      --argjson kept "$(printf '%s' "$kept_files" | jq -R . | jq -s 'map(select(length>0))')" \
      --argjson extras "$(printf '%s' "$extras" | jq -R 'split("\t") | select(length == 2) | {id: .[0], label: .[1]}' | jq -s .)" \
      '{from:$from,rev:$rev,base:$base,time:$time,files:$files,both:$both,kept:$kept,extras:$extras}' > "$STATE_DIR/incoming.json"
    if [ "$(cat "$STATE_DIR/notified" 2>/dev/null)" != "$up" ]; then
      echo "$up" > "$STATE_DIR/notified"
      notify_incoming "$from" "$applied" "$(printf '%s' "$extras" | cut -f2 | head -1)"
    fi
    return 10
  fi
  if [ -z "$dry" ]; then
    [ "$hypr" = 1 ] && hyprctl reload >/dev/null 2>&1
    [ "$applied" -gt 0 ] && herdr server reload-config >/dev/null 2>&1
    # Strictly behind: adopt the other machine's history (the backup that follows records the result).
    [ "$ff" = 1 ] && git -C "$REPO" merge -q --ff-only "$up" >/dev/null 2>&1
    if [ "$applied" -gt 0 ] || [ "$kept" -gt 0 ]; then
      notify-send "Synced from $from" "$applied files applied, $kept kept local (see: omarchy-sync pull --dry-run)" 2>/dev/null
      echo "synced from $from: $applied applied, $kept kept local"
    fi
  fi
  return 0
}

cmd_pull() { # [--dry-run] [--from <rev>]
  need_repo
  local dry="" arg
  while [ $# -gt 0 ]; do
    case "$1" in --dry-run|-n) dry="-n" ;; --from) PULL_FROM="${2:-}"; shift ;; --base) PULL_BASE="${2:-}"; shift ;; esac
    shift
  done
  take_lock; pull_changes "$dry"
}

# What was declined: declined.json = {files: {path: blob of the copy declined}, extras: {id: rev}}.
declined_blob() { jq -r --arg f "$1" '.files[$f] // empty' "$STATE_DIR/declined.json" 2>/dev/null; }
declined_extra() { jq -r --arg i "$1" '.extras[$i] // empty' "$STATE_DIR/declined.json" 2>/dev/null; }
EXTRA_IDS="theme packages plugins claude-prefs software keyboard"
is_extra() { case " $EXTRA_IDS " in *" $1 "*) return 0 ;; esac; return 1; }

# Split the items named on the command line into files (paths relative to $HOME) and extras (ids).
# No items = everything that is waiting. Sets SEL_FILES and SEL_EXTRAS (newline lists).
select_items() { # [item...]
  local inc="$STATE_DIR/incoming.json" it
  SEL_FILES=""; SEL_EXTRAS=""
  if [ $# -eq 0 ]; then SEL_FILES=$(jq -r '.files[]' "$inc" 2>/dev/null); SEL_EXTRAS=$(jq -r '.extras[].id' "$inc" 2>/dev/null); return; fi
  for it in "$@"; do
    it=${it#"$HOME"/}; it=${it#\~/}
    if is_extra "$it"; then SEL_EXTRAS+="$it"$'\n'; else SEL_FILES+="$it"$'\n'; fi
  done
}

# Take the answered items off incoming.json; nothing left = nothing waiting.
remove_incoming() { # files extras (newline lists)
  local inc="$STATE_DIR/incoming.json" tmp
  [ -f "$inc" ] || return 0
  tmp=$(mktemp)
  jq --argjson f "$(printf '%s' "$1" | jq -R . | jq -s 'map(select(length>0))')" \
     --argjson e "$(printf '%s' "$2" | jq -R . | jq -s 'map(select(length>0))')" \
     '.files -= $f | .both -= $f | .extras |= map(select([.id] | inside($e) | not))' "$inc" > "$tmp" && mv "$tmp" "$inc"
  [ "$(jq '(.files|length) + (.extras|length)' "$inc")" = 0 ] && rm -f "$inc"
  return 0
}

still_waiting() { # true (and says so) when items remain after a partial answer
  local inc="$STATE_DIR/incoming.json"
  [ -f "$inc" ] || return 1
  echo "still waiting from $(jq -r .from "$inc"): $(jq -r '.files|length' "$inc") files, $(jq -r '.extras|length' "$inc") other changes (nothing was backed up)"
  write_state ok "New configuration from $(jq -r .from "$inc") is waiting for your answer" "$(push_state)" '{}'
}

# A notification with Apply all / Not now buttons (when the notification daemon offers actions),
# detached from the backup service so it outlives this run. One change at a time: the bar widget.
notify_incoming() { # from nfiles first-extra
  local body="$2 files${3:+, $3}. Pick each change in the backup widget, or: omarchy-sync apply | skip"
  local script='a=$(timeout 900 notify-send -a Sync -A apply="Apply all" -A skip="Not now" "$1" "$2" 2>/dev/null); case "$a" in apply|skip) "$3" "$a" ;; esac'
  if command -v systemd-run >/dev/null && systemd-run --user --quiet --collect --unit="omarchy-sync-ask-$(date +%s%N)" \
       sh -c "$script" sh "New configuration from $1" "$body" "$TOOL/bin/omarchy-sync" 2>/dev/null; then return; fi
  setsid -f sh -c "$script" sh "New configuration from $1" "$body" "$TOOL/bin/omarchy-sync" >/dev/null 2>&1
}

# Apply what is waiting: everything, or only the given items (file paths and/or theme | packages |
# plugins | claude-prefs | software). Then back up, unless other items are still waiting.
do_apply() { # [item...]
  local inc="$STATE_DIR/incoming.json" rev base from
  rev=$(jq -r '.rev // empty' "$inc" 2>/dev/null)
  [ -n "$rev" ] || { echo "nothing waiting"; return 0; }
  base=$(jq -r '.base // empty' "$inc"); from=$(jq -r '.from // "another machine"' "$inc")
  select_items "$@"
  PULL_FROM=$rev PULL_BASE=$base ONLY_FILES=$SEL_FILES pull_changes ""
  [ -z "$SEL_EXTRAS" ] || ONLY_EXTRAS=$SEL_EXTRAS apply_extras "$rev" "$base"
  # Strictly behind: adopt the other machine's history. Whatever was not applied is then backed
  # up as this machine's own change, so the other machine gets asked about it in turn.
  git -C "$REPO" merge-base --is-ancestor HEAD "$rev" 2>/dev/null && git -C "$REPO" merge -q --ff-only "$rev" >/dev/null 2>&1
  remove_incoming "$SEL_FILES" "$SEL_EXTRAS"
  still_waiting && return 0
  # The other machine may have pushed again while this answer was pending: ask about that too
  # instead of backing up over it.
  pull_changes -s; [ $? = 10 ] && { still_waiting; return 0; }
  backup "sync: applied ${from}'s configuration"
}

cmd_run() {
  need_repo; self_update run "$@"; take_lock
  pull_changes -s; local rc=$?
  if [ "$rc" = 10 ]; then
    if [ "$(config_value AUTO_APPLY)" = 1 ]; then do_apply; return; fi
    echo "new configuration from $(jq -r .from "$STATE_DIR/incoming.json") is waiting: omarchy-sync apply | skip [item...]   (nothing was backed up)"
    write_state ok "New configuration from $(jq -r .from "$STATE_DIR/incoming.json") is waiting for your answer" "$(push_state)" '{}'
    return 0
  fi
  backup "${1:-}"
}

cmd_apply() { need_repo; self_update apply "$@"; take_lock; [ -f "$STATE_DIR/incoming.json" ] || { echo "nothing waiting"; return 0; }; do_apply "$@"; }

# Not now: keep this machine's version of everything waiting, or only of the given items. A declined
# copy is not asked about again until the other machine changes it; this machine's version is backed
# up as usual, so the other machine gets asked about it in turn.
cmd_skip() { # [item...]
  need_repo; take_lock
  local inc="$STATE_DIR/incoming.json" dec="$STATE_DIR/declined.json" rev it tmp
  [ -f "$inc" ] || { echo "nothing waiting"; return 0; }
  rev=$(jq -r .rev "$inc"); select_items "$@"
  [ -s "$dec" ] || echo '{"files":{},"extras":{}}' > "$dec"
  tmp=$(mktemp)
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    jq --arg f "$it" --arg b "$(git -C "$REPO" rev-parse -q "$rev:home/$it" 2>/dev/null)" '.files[$f] = $b' "$dec" > "$tmp" && mv "$tmp" "$dec"
  done <<<"$SEL_FILES"
  while IFS= read -r it; do
    [ -n "$it" ] || continue
    jq --arg i "$it" --arg r "$rev" '.extras[$i] = $r' "$dec" > "$tmp" && mv "$tmp" "$dec"
  done <<<"$SEL_EXTRAS"
  rm -f "$tmp"
  remove_incoming "$SEL_FILES" "$SEL_EXTRAS"
  still_waiting && return 0
  backup
}

push_state() {
  cd "$REPO" || return
  [ "$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)" = 0 ] && echo pushed || echo local
}

# One rsync for the whole list (spawning one per entry took ~4 s, and the bar widget asks every minute).
pending_count() {
  local list entry n
  list=$(mktemp)
  while IFS= read -r entry; do
    [[ -z "$entry" || "$entry" == \#* ]] && continue
    [ -e "$HOME/$entry" ] && printf '%s\n' "$entry"
  done < "$REPO/sync.list" > "$list"
  n=$(cd "$HOME" && rsync -aRcrn --files-from="$list" --max-size=$MAXSIZE "${EXCLUDES[@]}" --itemize-changes . "$REPO/home/" 2>/dev/null | grep -cE '^(>f|<f)')
  rm -f "$list"; echo "${n:-0}"
}

missing_packages() { # $1 = rev whose package list to compare with
  local rev="${1:-HEAD}"
  comm -23 <(git -C "$REPO" show "$rev:pkgs/native.txt" 2>/dev/null | sort -u) <(pacman -Qqn | sort -u)
  comm -23 <(git -C "$REPO" show "$rev:pkgs/foreign.txt" 2>/dev/null | sort -u) <(pacman -Qqm | sort -u)
}

cmd_status() {
  if ! repo_ready; then
    if [ "${1:-}" = "--json" ]; then
      jq -n --arg repo "$REPO" --arg interval "$(get_interval)" --arg intervals "$INTERVALS" \
        '{status:"unconfigured",message:"No backup location yet",repo:$repo,interval:$interval,
          intervals:($intervals|split(" ")),pending:0,unpushed:0,timer:"",nextEpoch:0,lastEpoch:0,
          running:false,remote:"",undocumented:[],missingPackages:[],commits:[]}'
    else
      echo "No backup location yet. Run: omarchy-sync init"
    fi
    return 0
  fi
  cd "$REPO" || exit 1
  local undoc pending ahead timer next running remote interval rrev missing
  local last_status=unknown last_msg="" last_time="" last_epoch=0 commits
  undoc=$(undocumented_ids | jq -R -s -c 'split("\n")|map(select(length>0))')
  pending=$(pending_count)
  ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  interval=$(get_interval)
  timer=$(systemctl --user is-active omarchy-sync.timer 2>/dev/null || true)
  next=$(systemctl --user list-timers omarchy-sync.timer -o json 2>/dev/null | jq -r '.[0].next // 0 | . / 1000000 | floor' 2>/dev/null || echo 0)
  running=false; systemctl --user is-active -q omarchy-sync.service 2>/dev/null && running=true
  flock -n "$LOCK" true 2>/dev/null || running=true
  remote=$(git remote get-url origin 2>/dev/null | sed -E 's#^git@github.com:#https://github.com/#; s#\.git$##')
  if [ -f "$STATE" ]; then
    last_status=$(jq -r .status "$STATE"); last_msg=$(jq -r .message "$STATE"); last_time=$(jq -r .time "$STATE")
    last_epoch=$(date -d "$last_time" +%s 2>/dev/null || echo 0)
  fi
  rrev=$(state_field restoreRev)
  missing=$(missing_packages "${rrev:-HEAD}" | jq -R -s -c 'split("\n")|map(select(length>0))')
  commits=$(git log -5 --format='@@%h%x09%ct%x09%cr%x09%s' --shortstat \
    | awk -F'\t' '/^@@/ {if (h) print h "\t" f; sub(/^@@/,""); h=$0; f=0; next}
                  /files? changed/ {f=$0+0} END {if (h) print h "\t" f}' \
    | while IFS=$'\t' read -r h rest; do printf '%s\t%s\t%s\n' "$h" "$rest" "$(machine_of "$h")"; done \
    | jq -R -s -c 'split("\n")|map(select(length>0)|split("\t")|{hash:.[0],epoch:(.[1]|tonumber),when:.[2],subject:.[3],files:(.[4]|tonumber),machine:.[5]})')
  if [ "${1:-}" = "--json" ]; then
    jq -n --arg st "$last_status" --arg msg "$last_msg" --arg time "$last_time" --argjson lastEpoch "$last_epoch" \
      --argjson pending "$pending" --argjson ahead "$ahead" --arg timer "$timer" --argjson next "${next:-0}" \
      --arg interval "$interval" --arg intervals "$INTERVALS" --argjson running "$running" --arg remote "$remote" \
      --argjson undoc "$undoc" --argjson missing "$missing" --arg rrev "$rrev" --argjson commits "$commits" \
      --arg repo "$REPO" --arg machine "$MACHINE" \
      --argjson incoming "$(cat "$STATE_DIR/incoming.json" 2>/dev/null || echo null)" \
      '{incoming:$incoming,repo:$repo,machine:$machine,status:$st,message:$msg,time:$time,lastEpoch:$lastEpoch,pending:$pending,unpushed:$ahead,timer:$timer,
        nextEpoch:$next,interval:$interval,intervals:($intervals|split(" ")),running:$running,remote:$remote,
        undocumented:$undoc,missingPackages:$missing,restoreRev:$rrev,commits:$commits}'
  else
    echo "This machine   : $MACHINE"
    echo "Last backup    : $last_time ($last_status) $last_msg"
    echo "Schedule       : every $interval ($timer)$([ "${next:-0}" -gt 0 ] && date -d "@$next" '+, next at %H:%M')"
    echo "Not backed up  : $pending files    Not pushed: $ahead commits"
    echo "Undocumented   : $(jq -r 'if length == 0 then "none" else join(" ") end' <<<"$undoc")"
    echo "Missing pkgs   : $(jq -r 'if length == 0 then "none" else join(" ") end' <<<"$missing")"
    echo "Last 5 backups:"; cmd_log 5 | sed 's/^/  /'
  fi
}

cmd_log() { # [N] [machine]
  local n="${1:-5}" only="${2:-}" h d s m shown=0
  while IFS=$'\t' read -r h d s; do
    m=$(machine_of "$h")
    [ -z "$only" ] || [ "$m" = "$only" ] || continue
    printf '%s  %s  %-10s  %s\n' "$h" "$d" "$m" "$s"
    shown=$((shown + 1)); [ "$shown" -lt "$n" ] || break
  done < <(git -C "$REPO" log -300 --format='%h%x09%cd%x09%s' --date=format:'%Y-%m-%d %H:%M')
}

cmd_machines() {
  need_repo
  local h d m seen=" "
  while IFS=$'\t' read -r h d; do
    m=$(machine_of "$h")
    [[ "$m" == "?" || "$seen" == *" $m "* ]] && continue
    seen+="$m "
    printf '%-10s  latest %s  %s%s\n' "$m" "$h" "$d" "$([ "$m" = "$MACHINE" ] && echo "  (this machine)")"
  done < <(git -C "$REPO" log -300 --format='%h%x09%cd' --date=format:'%Y-%m-%d %H:%M')
}

cmd_interval() {
  local v="${1:-}"
  if [ -z "$v" ]; then get_interval; return; fi
  [[ " $INTERVALS " == *" $v "* ]] || { echo "usage: omarchy-sync interval <${INTERVALS// /|}>" >&2; exit 1; }
  mkdir -p "$UNIT_DIR/omarchy-sync.timer.d"
  set_config INTERVAL "$v"
  if [ "$v" = off ]; then
    systemctl --user disable --now omarchy-sync.timer >/dev/null 2>&1
    echo "automatic backups off"; return
  fi
  local cal
  case "$v" in 15min) cal="*:0/15" ;; 30min) cal="*:0/30" ;; 1h) cal="hourly" ;; 6h) cal="00/6:00" ;; 12h) cal="00/12:00" ;; 24h) cal="daily" ;; esac
  printf '[Timer]\nOnUnitActiveSec=\nOnCalendar=\nOnCalendar=%s\n' "$cal" > "$UNIT_DIR/omarchy-sync.timer.d/interval.conf"
  systemctl --user daemon-reload
  systemctl --user enable omarchy-sync.timer >/dev/null 2>&1
  systemctl --user restart omarchy-sync.timer
  echo "backing up every $v"
}

cmd_restore() {
  need_repo
  local rev="" dry="" arg sha short tmp changed n from
  for arg in "$@"; do
    case "$arg" in --dry-run|-n) dry="-n" ;; *) rev="$arg" ;; esac
  done
  [ -n "$rev" ] || { echo "usage: omarchy-sync restore <rev|machine> [--dry-run]" >&2; exit 1; }
  # A machine name restores that machine's latest backup.
  sha=$(git -C "$REPO" rev-parse --verify -q "$rev^{commit}") \
    || sha=$(latest_of_machine "$rev") \
    || { echo "unknown backup or machine: $rev (see 'omarchy-sync machines')" >&2; exit 1; }
  short=$(git -C "$REPO" rev-parse --short "$sha")
  from=$(machine_of "$sha")
  git -C "$REPO" cat-file -e "$sha:home" 2>/dev/null || { echo "backup $short has no home/ files" >&2; exit 1; }
  echo "backup $short from machine '$from' -> this machine '$MACHINE'" >&2

  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  git -C "$REPO" archive "$sha" home | tar -x -C "$tmp"
  # Screen, backup location and per-screen text size are each machine's own business.
  for f in "${MACHINE_LOCAL[@]}"; do rm -f "$tmp/home/$f"; done

  if [ -n "$dry" ]; then
    rsync -ac -n --itemize-changes "$tmp/home/" "$HOME/" | grep -E '^>f' | awk '{print $2}'
    return
  fi

  take_lock
  # Save the current setup first, so the restore itself can be undone.
  backup "snapshot: before restoring $short" >/dev/null || { echo "could not save the current setup; restore cancelled" >&2; exit 1; }

  changed=$(rsync -ac --itemize-changes "$tmp/home/" "$HOME/" | grep -cE '^>f')
  hyprctl reload >/dev/null 2>&1 || true
  apply_look "$sha"
  herdr server reload-config >/dev/null 2>&1 || true

  n=$(missing_packages "$sha" | wc -l)
  backup "restore: $short from $from ($changed files)" >/dev/null
  # restoreRev lets status report packages that backup had and this machine lacks.
  write_state ok "Restored $short from $from ($changed files)" "$(push_state)" "$(jq -n --arg r "$sha" '{restoreRev:$r}')"
  echo "restored $short from $from: $changed files"
  [ "$n" -gt 0 ] && echo "$n packages from that backup are not installed: run 'omarchy-sync restore-packages $short'"
  return 0
}

cmd_restore_packages() {
  local rev="${1:-$(state_field restoreRev)}" native foreign
  rev="${rev:-HEAD}"
  native=$(comm -23 <(git -C "$REPO" show "$rev:pkgs/native.txt" | sort -u) <(pacman -Qqn | sort -u))
  foreign=$(comm -23 <(git -C "$REPO" show "$rev:pkgs/foreign.txt" 2>/dev/null | sort -u) <(pacman -Qqm | sort -u))
  if [ -z "$native$foreign" ]; then echo "all packages are installed"; return 0; fi
  [ -n "$native" ] && { echo "==> pacman: $(echo $native)"; sudo pacman -S --needed $native; }
  [ -n "$foreign" ] && { echo "==> AUR: $(echo $foreign)"; yay -S --needed $foreign; }
  echo "done. Press Enter to close."; read -r _ || true
}

cmd_install() {
  local pl="$PLUGIN_DIR"
  mkdir -p "$UNIT_DIR" "$HOME/.local/bin" "$pl"
  ln -sf "$TOOL/bin/omarchy-sync" "$HOME/.local/bin/omarchy-sync"
  cp "$TOOL/systemd/omarchy-sync.service" "$TOOL/systemd/omarchy-sync.timer" "$UNIT_DIR/"
  rsync -a --delete "$TOOL"/plugin/jj.backup-status/ "$pl/"
  [ -n "$(config_value REPO)" ] || set_config REPO "$REPO"
  systemctl --user daemon-reload
  cmd_interval "$(get_interval)" >/dev/null
  echo "installed: timer (every $(get_interval)) + bar plugin, backing up into $REPO"
  echo "add the widget with: omarchy bar put jj.backup-status --section right"
}

ask() { # prompt default -> answer (default when not interactive)
  local a=""
  if [ -t 0 ]; then read -r -p "$1 [$2]: " a || true; fi
  echo "${a:-$2}"
}

# Choose where backups go: an existing repo, a new local repo, and optionally a private GitHub repo.
cmd_init() {
  local path="" mode="" target="" arg
  while [ $# -gt 0 ]; do
    case "$1" in
      --github) mode=github; target="${2:-}"; shift ;;
      --remote) mode=remote; target="${2:-}"; shift ;;
      --local)  mode=local ;;
      *) path="$1" ;;
    esac
    shift
  done
  if [ -z "$path" ]; then
    echo "Backups are kept in a git repo folder. A plain name like 'my-backup' goes inside $HOME."
    path=$(ask "Folder for the backup repo" "$HOME/omarchy-sync")
  fi
  path=$(abs_path "$path")
  if [ -t 0 ]; then
    case "$(ask "Use $path?" "Y")" in [Nn]*) echo "cancelled"; exit 1 ;; esac
  fi
  mkdir -p "$(dirname "$path")"

  if [ -z "$mode" ] && ! git -C "$path" remote get-url origin >/dev/null 2>&1; then
    echo "Where should the backup be pushed?"
    echo "  1) a new private GitHub repo (needs gh)"
    echo "  2) an existing git remote (URL)"
    echo "  3) nowhere, keep it on this machine only"
    case "$(ask "Choose" 1)" in
      1) mode=github ;;
      2) mode=remote; target=$(ask "Remote URL" "") ;;
      *) mode=local ;;
    esac
  fi
  if [ "$mode" = remote ] && [ -n "$target" ] && [ ! -e "$path/.git" ] && [ -z "$(ls -A "$path" 2>/dev/null)" ]; then
    git clone -q "$target" "$path" 2>/dev/null || true   # reuse an existing backup if the remote has one
  fi

  if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
    mkdir -p "$path"; git -C "$path" init -q -b main
  fi
  [ -f "$path/sync.list" ] || cp "$TOOL/templates/sync.list" "$path/sync.list"
  [ -f "$path/AGENTS.md" ] || cp "$TOOL/templates/AGENTS.md" "$path/AGENTS.md"
  [ -f "$path/.gitignore" ] || cp "$TOOL/templates/gitignore" "$path/.gitignore"
  mkdir -p "$path/apps" "$path/home" "$path/pkgs"

  set_config REPO "$path"; REPO="$path"
  if ! git -C "$path" rev-parse -q --verify HEAD >/dev/null; then
    git -C "$path" add -A && git -C "$path" commit -q -m "Set up omarchy-sync backup"
  fi

  if ! git -C "$path" remote get-url origin >/dev/null 2>&1; then
    case "$mode" in
      github)
        command -v gh >/dev/null && gh auth status >/dev/null 2>&1 || { echo "gh is not signed in: run 'gh auth login' and then 'omarchy-sync init $path --github NAME'" >&2; exit 1; }
        [ -n "$target" ] || target=$(ask "GitHub repo name" "$(basename "$path")")
        gh repo create "$target" --private --source "$path" --push --description "Omarchy machine backup (omarchy-sync)" ;;
      remote)
        [ -n "$target" ] || { echo "no remote URL given" >&2; exit 1; }
        git -C "$path" remote add origin "$target"
        git -C "$path" push -q -u origin HEAD ;;
      *) echo "keeping backups on this machine only (add a remote later with git remote add origin <url>)" ;;
    esac
  fi

  echo "backups go to $path$(git -C "$path" remote get-url origin >/dev/null 2>&1 && echo " -> $(git -C "$path" remote get-url origin)")"
  [ -f "$UNIT_DIR/omarchy-sync.timer" ] || cmd_install
  take_lock; backup "backup: first backup" || true
  if [ -t 0 ]; then echo "Press Enter to close."; read -r _ || true; fi
}

# New machine: everything the backup repo records, then the timer and the bar plugin.
cmd_setup() {
  local repo omz r d a
  repo=$(abs_path "${1:-$REPO}")
  [ -d "$repo/.git" ] || { echo "backup repo not found: $repo" >&2; exit 1; }
  set_config REPO "$repo"; REPO="$repo"
  cd "$REPO" || exit 1

  echo "==> Packages (sudo)"
  sudo pacman -S --needed --noconfirm - < pkgs/native.txt || echo "(some packages failed; check pkgs/native.txt)"
  if command -v yay >/dev/null && [ -s pkgs/foreign.txt ]; then
    echo "==> AUR/foreign packages"
    yay -S --needed --noconfirm - < pkgs/foreign.txt || echo "(check pkgs/foreign.txt)"
  fi

  echo "==> Files (existing ones are kept as *.pre-dotfiles)"
  rsync -a --backup --suffix=.pre-dotfiles home/ "$HOME"/
  set_config REPO "$REPO"   # the restored config names the old machine's folder

  echo "==> Oh My Zsh, Powerlevel10k and plugins"
  omz="$HOME/.local/share/oh-my-zsh"
  [ -d "$omz" ] || git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh "$omz"
  for r in romkatv/powerlevel10k zsh-users/zsh-autosuggestions zsh-users/zsh-syntax-highlighting; do
    d="$omz/custom/$( [[ $r == *powerlevel10k ]] && echo themes || echo plugins )/${r##*/}"
    [ -d "$d" ] || git clone --depth 1 "https://github.com/$r" "$d" 2>/dev/null || true
  done

  echo "==> Tools, services and integrations"
  command -v mise >/dev/null && mise install || true
  while read -r u; do [ -n "$u" ] && systemctl --user enable "$u" 2>/dev/null || true; done < pkgs/services-user.txt
  [ -s pkgs/dconf.ini ] && dconf load / < pkgs/dconf.ini || true
  if command -v pnpm >/dev/null && [ -s pkgs/pnpm-global.txt ]; then
    for a in $(sed -n 's/^[├└]── \(.*\)@[^@]*$/\1/p' pkgs/pnpm-global.txt | grep -vx pnpm); do pnpm add -g "$a" || true; done
  fi
  # Pi reads its packages from ~/.pi/agent/settings.json (restored above); install each one
  if command -v pi >/dev/null && [ -f "$HOME/.pi/agent/settings.json" ]; then
    for a in $(jq -r '.packages[]? | strings' "$HOME/.pi/agent/settings.json"); do pi install "$a" || true; done
  fi
  if command -v herdr >/dev/null; then
    for a in $(awk -F: '/: (current|outdated)/ {print $1}' pkgs/herdr-integrations.txt); do herdr integration install "$a" || true; done
  fi
  if command -v omarchy >/dev/null && [ -s pkgs/omarchy-theme.txt ]; then
    { read -r t; read -r bg; } < pkgs/omarchy-theme.txt
    omarchy theme set "$t" || true
    [ -n "$bg" ] && omarchy theme bg set "$HOME/.local/state/omarchy/current/theme/backgrounds/$bg" || true
  fi
  apply_look HEAD
  apply_claude_state HEAD
  apply_claude_plugins HEAD

  echo "==> Automatic backup"
  cmd_install
  command -v omarchy >/dev/null && omarchy bar put jj.backup-status --section right >/dev/null 2>&1 || true
  echo "==> Done. Log in again, then follow AGENTS.md for software outside pacman."
}

cmd_restore_github() { # [owner/name] [path]: fresh machine -> GitHub sign-in -> clone backup -> setup
  local repo="${1:-}" path="${2:-}"
  command -v gh >/dev/null || { echo "==> GitHub CLI (sudo)"; sudo pacman -S --needed --noconfirm github-cli; }
  gh auth status >/dev/null 2>&1 || gh auth login --hostname github.com --git-protocol https --web || exit 1
  gh auth setup-git
  if [ -z "$repo" ]; then
    echo "Your repos:"; gh repo list --limit 30 --json nameWithOwner,isPrivate -q '.[] | select(.isPrivate) | "  " + .nameWithOwner'
    repo=$(ask "Backup repo (owner/name)" "")
    [ -n "$repo" ] || { echo "no repo given" >&2; exit 1; }
  fi
  [ -n "$path" ] || path=$(ask "Folder for the backup repo" "$HOME/${repo##*/}")
  path=$(abs_path "$path")
  if [ -d "$path/.git" ]; then git -C "$path" pull -q --ff-only || true; else gh repo clone "$repo" "$path" || exit 1; fi
  [ -f "$path/sync.list" ] || { echo "$repo is not an omarchy-sync backup (no sync.list)" >&2; exit 1; }

  local revs choice rev
  REPO="$path"
  echo "Machines in this backup:"; cmd_machines | sed 's/^/  /'
  mapfile -t revs < <(git -C "$path" log -20 --format='%h')
  echo "Which backup do you want on this machine ($MACHINE)?"
  cmd_log 20 | nl -w3 -s') '
  choice=$(ask "Number" 1)
  rev=${revs[$((choice - 1))]:-}
  [ -n "$rev" ] || { echo "no backup number $choice" >&2; exit 1; }
  [ "$rev" = "${revs[0]}" ] || git -C "$path" restore --source="$rev" --staged --worktree -- home pkgs

  cmd_setup "$path"
  if ! git -C "$path" diff --cached --quiet; then
    git -C "$path" commit -q -m "restore: $rev from $(machine_of "$rev") on $MACHINE" --trailer "Machine: $MACHINE" && git -C "$path" push -q || true
  fi
  if [ -t 0 ]; then echo "Press Enter to close."; read -r _ || true; fi
}

cmd_uninstall() {
  systemctl --user disable --now omarchy-sync.timer 2>/dev/null
  rm -rf "$UNIT_DIR"/omarchy-sync.{service,timer} "$UNIT_DIR/omarchy-sync.timer.d" "$HOME/.local/bin/omarchy-sync"
  systemctl --user daemon-reload
}

case "${1:-status}" in
  run) shift; cmd_run "$@" ;;
  pull) shift; cmd_pull "$@" ;;
  apply) shift; cmd_apply "$@" ;;
  skip) shift; cmd_skip "$@" ;;
  status) shift; cmd_status "${1:-}" ;;
  log) shift; cmd_log "${1:-5}" "${2:-}" ;;
  machines) cmd_machines ;;
  interval) shift; cmd_interval "${1:-}" ;;
  restore) shift; cmd_restore "$@" ;;
  restore-packages) shift; cmd_restore_packages "${1:-}" ;;
  init) shift; cmd_init "$@" ;;
  setup) shift; cmd_setup "${1:-}" ;;
  restore-github) shift; cmd_restore_github "$@" ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
