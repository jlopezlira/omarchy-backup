[Unit]
Description=Scheduled Omarchy backup

[Timer]
OnBootSec=5min
# Wall-clock schedule (omarchy-sync interval rewrites it). Monotonic OnUnitActiveSec left the timer
# "elapsed" with nothing scheduled whenever it was restarted before the service had run that boot.
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
